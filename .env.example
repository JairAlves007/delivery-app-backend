# ENVIRONMENT
NODE_ENV="development"
PORT="3333"
BASE_URL="http://localhost:3333"
# CORS: origens permitidas em produção (separadas por vírgula)
ALLOWED_ORIGINS="https://app.delivery.com.br,https://admin.delivery.com.br"
# Atrás de proxy/WAF? "true" para confiar no X-Forwarded-* (IP real no rate-limit)
TRUST_PROXY="false"
PUBLIC_BUCKET_URL="your_public_bucket_url"

# DATABASE
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
DATABASE_USER="user"
DATABASE_PASSWORD="password"
DATABASE_NAME="database"

# JWT
JWT_SECRET="your_jwt_secret_here"

# PUBLIC API (key required on public client routes via x-api-key header)
PUBLIC_API_KEY="your_public_api_key_min_16_chars"

# CLOUDFLARE
CLOUDFLARE_ENDPOINT="your_cloudflare_endpoint"
CLOUDFLARE_ACCESS_KEY_ID="your_access_key_id"
CLOUDFLARE_SECRET_ACCESS_KEY="your_secret_access_key"
CLOUDFLARE_BUCKET_NAME="your_bucket_name"

# REDIS
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
# REDIS_PASSWORD="admin" # Could be empty

# WHATSAPP (Evolution API)
# Webhook: configure a Evolution para enviar o header "x-webhook-token" com este valor
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="your_evolution_global_api_key"
EVOLUTION_WEBHOOK_TOKEN="your_webhook_token_min_16_chars"