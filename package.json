    "dotenv-cli": "10.0.0",
    "prisma": "6.18.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.864.0",
    "@aws-sdk/s3-request-presigner": "3.864.0",
    "@fastify/cors": "11.1.0",
    "@fastify/jwt": "9.1.0",
    "@prisma/client": "6.17.0",
    "@trigger.dev/sdk": "4.0.6",
    "bcrypt-ts": "7.1.0",
    "ejs": "3.1.10",
    "esm-module-alias": "2.2.1",
    "fastify": "5.4.0",
    "ioredis": "5.7.0",
    "pino-pretty": "13.1.1",
