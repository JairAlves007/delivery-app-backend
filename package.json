{
	"name": "delivery-micro-saas-backend",
	"version": "1.0.0",
	"description": "Delivery Micro SAAS Backend",
	"scripts": {
		"dev": "tsx --watch --env-file .env src/http/server.ts",
		"build": "rm -rf dist && tsc --project tsconfig.json && tsc-alias -p tsconfig.json && cp -r src/templates dist/templates",
		"start": "node dist/http/server.js",
		"db:migrate": "prisma migrate dev",
		"db:studio": "prisma studio",
		"cache:flush": "tsx --env-file .env src/scripts/flush-cache.ts",
		"lint": "eslint ."
	},
	"keywords": [],
	"author": "Jair Alves",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.8.0",
	"engines": {
		"node": "24.x"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/ejs": "3.1.5",
		"@types/node": "24.12.0",
		"eslint": "10.1.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-simple-import-sort": "12.1.1",
		"globals": "17.4.0",
		"pino-pretty": "13.1.3",
		"prisma": "7.8.0",
		"tsc-alias": "1.8.16",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.57.2"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1019.0",
		"@aws-sdk/s3-request-presigner": "3.1019.0",
		"@fastify/cors": "11.2.0",
		"@fastify/helmet": "13.0.2",
		"@fastify/jwt": "9.1.0",
		"@fastify/rate-limit": "10.3.0",
		"@fastify/swagger": "9.7.0",
		"@prisma/adapter-pg": "7.6.0",
		"@prisma/client": "7.8.0",
		"@scalar/fastify-api-reference": "1.49.8",
		"bcrypt-ts": "7.1.0",
		"bullmq": "5.71.1",
		"dotenv": "17.3.1",
		"ejs": "3.1.10",
		"exceljs": "4.4.0",
		"fastify": "5.8.4",
		"fastify-plugin": "5.1.0",
		"fastify-type-provider-zod": "6.1.0",
		"ioredis": "5.10.1",
		"puppeteer": "25.1.0",
		"zod": "4.3.6"
	}
}
