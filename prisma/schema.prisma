generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatusType {
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethodType {
  CARD
  PIX
  MONEY
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum BannerLinkType {
  NONE
  PRODUCT
  CATEGORY
}

enum CouponType {
  SHIPPING
  ORDER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum AddonType {
  QUANTITY
  MULTIPLE_CHOICE
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TWITTER
  WHATSAPP
  TIKTOK
}

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum RoleType {
  CUSTOMER
  ESTABLISHMENT_OWNER
  ADMIN
}

enum PermissionType {
  // Customer
  VIEW_CATALOG
  ADD_TO_CART
  MANAGE_OWN_ADDRESSES
  VIEW_OWN_ORDERS
  CANCEL_OWN_ORDER

  // Establishment Owner
  MANAGE_PRODUCTS
  MANAGE_CATEGORIES
  MANAGE_PRODUCT_OPTIONS
  MANAGE_DISTRICTS
  MANAGE_ORDERS
  MANAGE_OWN_ESTABLISHMENT
  MANAGE_BANNERS
  MANAGE_COUPONS
  VIEW_CUSTOMERS

  // Admin
  MANAGE_ESTABLISHMENTS
  MANAGE_USERS
}

enum TagType {
  FOOD
  DRINK
  COMBO
  DESSERT
  SNACK
  SIDE
  ALCOHOLIC_DRINK
  NON_ALCOHOLIC_DRINK
  HOT_DRINK
  COLD_DRINK
  COFFEE
  TEA
  JUICE
  SODA
  MILK_SHAKE
  SMOOTHIE
  ICE_CREAM
  BREAKFAST
  LUNCH
  DINNER
  FRUIT
  VEGETABLE
  MEAT
  FISH
  APPETIZER
  PASTRY
  SALAD
  SOUP
  PIZZA
  BURGER
  SANDWICH
  PASTA
  GRILL
  SUSHI
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
  CAKE
  COOKIE
  PIE
}

enum ResourceType {
  BANNER
  LOGO
  THUMBNAIL
}

enum ForObjectResourceType {
  ESTABLISHMENT
  PRODUCT
  CATEGORY
  BANNER
}

enum FileFormatType {
  PNG
  JPG
  JPEG
}

model Role {
  id          Int              @id @default(autoincrement())
  name        RoleType         @unique
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  PermissionType   @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int
  role          Role       @relation(fields: [role_id], references: [id])
  permission    Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@index([role_id], name: "idx_role_permissions_role_id")
  @@index([permission_id], name: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model User {
  id                  String               @id @default(ulid())
  name                String
  email               String               @unique
  password            String
  role_id             Int
  created_at          DateTime             @default(now())
  deleted_at          DateTime?
  role                Role                 @relation(fields: [role_id], references: [id])
  addresses           UserAddress[]
  orders              Order[]
  favorites           Favorite[]
  userCoupons         UserCoupon[]
  establishment       Establishment?
  passwordResetTokens PasswordResetToken[]

  @@index([role_id], name: "idx_users_role_id")
  @@index([deleted_at], name: "idx_users_deleted_at")
  @@map("users")
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  user_id    String
  token_hash String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("password_reset_tokens")
}

model Menu {
  id               Int           @id @default(autoincrement())
  label            String
  slug             String
  order            Int
  submenus         SubMenu[]
  for_role         RoleType
  establishment_id String
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  establishment    Establishment @relation(fields: [establishment_id], references: [id])

  @@unique([establishment_id, slug, for_role])
  @@map("menus")
}

model SubMenu {
  id      Int    @id @default(autoincrement())
  label   String
  slug    String
  order   Int
  menu_id Int
  menu    Menu   @relation(fields: [menu_id], references: [id])

  @@unique([menu_id, slug])
  @@map("submenus")
}

model Establishment {
  id                     String                  @id @default(ulid())
  name                   String
  slug                   String                  @unique
  description            String
  email                  String                  @unique
  cnpj                   String?                 @unique
  only_delivery          Boolean
  accepts_credit_card    Boolean
  is_manually_closed     Boolean                 @default(false)
  next_billing_date      DateTime
  owner_id               String?                 @unique
  created_at             DateTime                @default(now())
  deleted_at             DateTime?
  owner                  User?                   @relation(fields: [owner_id], references: [id])
  openingHours           OpeningHour[]
  socialLinks            SocialLink[]
  products               Product[]
  categories             ProductCategory[]
  banners                Banner[]
  districts              District[]
  coupons                Coupon[]
  addonCategories        AddonCategory[]
  orders                 Order[]
  menus                  Menu[]
  closures               Closure[]
  tags                   Tag[]
  address                EstablishmentAddress?
  deliveryAddresses      DeliveryAddress[]
  establishmentResources Resource[]
  resources              EstablishmentResource[]
  resourceRules          ResourceRule[]

  @@map("establishments")
}

model OpeningHour {
  id               Int           @id @default(autoincrement())
  establishment_id String
  day_of_week      WeekDay
  opens_at         String
  closes_at        String
  is_closed        Boolean
  establishment    Establishment @relation(fields: [establishment_id], references: [id])

  @@map("opening_hours")
}

model Closure {
  id               Int           @id @default(autoincrement())
  establishment_id String
  starts_at        DateTime
  ends_at          DateTime?
  reason           String?
  establishment    Establishment @relation(fields: [establishment_id], references: [id])

  @@map("closures")
}

model SocialLink {
  id               Int            @id @default(autoincrement())
  establishment_id String
  platform         SocialPlatform
  url              String
  establishment    Establishment  @relation(fields: [establishment_id], references: [id])

  @@unique([platform, establishment_id])
  @@map("social_links")
}

model ProductCategory {
  id               String                    @id @default(ulid())
  establishment_id String
  name             String
  slug             String
  order            Int?
  deleted_at       DateTime?
  establishment    Establishment             @relation(fields: [establishment_id], references: [id])
  products         Product[]
  banners          Banner[]
  resources        ProductCategoryResource[]

  @@unique([slug, establishment_id])
  @@map("product_categories")
}

model Product {
  id                  String            @id @default(ulid())
  establishment_id    String
  category_id         String
  name                String
  description         String
  price               Int
  slug                String
  discount_percentage Float?
  stock               Int?
  valid_until         DateTime?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  deleted_at          DateTime?
  establishment       Establishment     @relation(fields: [establishment_id], references: [id])
  category            ProductCategory   @relation(fields: [category_id], references: [id])
  favorites           Favorite[]
  orderItems          OrderItem[]
  banners             Banner[]
  tags                ProductTag[]
  resources           ProductResource[]

  @@unique([slug, establishment_id])
  @@map("products")
}

model Tag {
  id               Int              @id @default(autoincrement())
  establishment_id String
  name             TagType
  deleted_at       DateTime?
  establishment    Establishment    @relation(fields: [establishment_id], references: [id])
  productTags      ProductTag[]
  fromTags         TagCombination[] @relation("FromTag")
  toTags           TagCombination[] @relation("ToTag")

  @@unique([name, establishment_id])
}

model TagCombination {
  id          Int @id @default(autoincrement())
  from_tag_id Int
  to_tag_id   Int
  from_tag    Tag @relation("FromTag", fields: [from_tag_id], references: [id])
  to_tag      Tag @relation("ToTag", fields: [to_tag_id], references: [id])

  @@unique([from_tag_id, to_tag_id])
}

model ProductTag {
  product_id String
  tag_id     Int
  product    Product @relation(fields: [product_id], references: [id])
  tag        Tag     @relation(fields: [tag_id], references: [id])

  @@id([product_id, tag_id])
}

model AddonCategory {
  id               Int           @id @default(autoincrement())
  establishment_id String
  name             String
  type             AddonType
  max_quantity     Int?
  deleted_at       DateTime?
  establishment    Establishment @relation(fields: [establishment_id], references: [id])
  addons           Addon[]

  @@unique([name, establishment_id])
  @@map("addon_categories")
}

model Addon {
  id              Int              @id @default(autoincrement())
  category_id     Int
  name            String
  price           Int              @default(0)
  deleted_at      DateTime?
  category        AddonCategory    @relation(fields: [category_id], references: [id])
  orderItemAddons OrderItemAddon[]

  @@unique([name, category_id])
  @@map("addons")
}

model District {
  id                     String                 @id @default(ulid())
  establishment_id       String
  name                   String
  shipping_cost          Int
  establishment          Establishment          @relation(fields: [establishment_id], references: [id])
  deliveryLinks          DeliveryAddress[]
  deleted_at             DateTime?
  orderDeliveryAddresses OrderDeliveryAddress[]

  @@unique([name, establishment_id])
  @@map("districts")
}

model Coupon {
  id               Int           @id @default(autoincrement())
  establishment_id String
  code             String        @unique
  type             CouponType
  discount_type    DiscountType
  value            Float
  starts_at        DateTime?
  ends_at          DateTime?
  deleted_at       DateTime?
  max_uses         Int?
  uses_per_user    Int?
  establishment    Establishment @relation(fields: [establishment_id], references: [id])
  orders           Order[]
  userCoupons      UserCoupon[]

  @@index([establishment_id], name: "idx_coupons_establishment_id")
  @@index([deleted_at], name: "idx_coupons_deleted_at")
  @@map("coupons")
}

model UserCoupon {
  id        Int    @id @default(autoincrement())
  user_id   String
  coupon_id Int
  user      User   @relation(fields: [user_id], references: [id])
  coupon    Coupon @relation(fields: [coupon_id], references: [id])

  @@index([user_id], name: "idx_user_coupons_user_id")
  @@index([coupon_id], name: "idx_user_coupons_coupon_id")
  @@map("user_coupons")
}

model Favorite {
  id         Int     @id @default(autoincrement())
  user_id    String
  product_id String
  user       User    @relation(fields: [user_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])

  @@index([user_id], name: "idx_favorites_user_id")
  @@index([product_id], name: "idx_favorites_product_id")
  @@map("favorites")
}

model Banner {
  id               Int              @id @default(autoincrement())
  name             String
  establishment_id String
  link_type        BannerLinkType
  product_id       String?
  category_id      String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?
  product          Product?         @relation(fields: [product_id], references: [id])
  category         ProductCategory? @relation(fields: [category_id], references: [id])
  establishment    Establishment    @relation(fields: [establishment_id], references: [id])
  resources        BannerResource[]

  @@map("banners")
}

model Order {
  id                   String                @id @default(ulid())
  comment              String?
  change_amount        Int?
  payment_method       PaymentMethodType
  delivery_type        DeliveryType
  shipping_fee         Int
  subtotal             Int
  customer_name        String
  customer_phone       String
  user_id              String
  establishment_id     String
  coupon_id            Int?
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt
  deleted_at           DateTime?
  user                 User                  @relation(fields: [user_id], references: [id])
  establishment        Establishment         @relation(fields: [establishment_id], references: [id])
  items                OrderItem[]
  statuses             OrderStatus[]
  coupon               Coupon?               @relation(fields: [coupon_id], references: [id])
  orderCoupon          OrderCoupon?
  orderDeliveryAddress OrderDeliveryAddress?

  @@map("orders")
}

model OrderCoupon {
  id             Int          @id @default(autoincrement())
  order_id       String       @unique
  code           String
  discount_type  DiscountType
  discount_value Int
  created_at     DateTime     @default(now())
  order          Order        @relation(fields: [order_id], references: [id])

  @@map("order_coupons")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  order_id      String
  product_id    String
  product_name  String
  product_price Int
  quantity      Int
  observation   String?
  created_at    DateTime @default(now())

  order   Order            @relation(fields: [order_id], references: [id])
  product Product          @relation(fields: [product_id], references: [id])
  addons  OrderItemAddon[]

  @@map("order_items")
}

model OrderItemAddon {
  id            Int       @id @default(autoincrement())
  order_item_id Int
  addon_price   Int       @default(0)
  addon_name    String
  addon_id      Int
  quantity      Int
  orderItem     OrderItem @relation(fields: [order_item_id], references: [id])
  addon         Addon     @relation(fields: [addon_id], references: [id])

  @@index([order_item_id], name: "idx_order_item_addons_order_item_id")
  @@index([addon_id], name: "idx_order_item_addons_addon_id")
  @@map("order_item_addons")
}

model OrderStatus {
  id         Int             @id @default(autoincrement())
  order_id   String
  label      String
  value      OrderStatusType
  created_at DateTime        @default(now())
  order      Order           @relation(fields: [order_id], references: [id])

  @@unique([order_id, value])
  @@map("order_statuses")
}

model Address {
  id                     String                 @id @default(ulid())
  street                 String
  number                 String?                @default("N/A")
  neighborhood           String
  city                   String
  state                  String
  postal_code            String
  complement             String?
  reference_point        String?
  phone                  String
  latitude               Float?
  longitude              Float?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  deleted_at             DateTime?
  userAddresses          UserAddress[]
  establishmentAddresses EstablishmentAddress[]
  orderDeliveryAddresses OrderDeliveryAddress[]

  @@index([deleted_at], name: "idx_addresses_deleted_at")
  @@map("addresses")
}

model UserAddress {
  id                String            @id @default(ulid())
  user_id           String
  address_id        String
  is_default        Boolean           @default(false)
  created_at        DateTime          @default(now())
  deleted_at        DateTime?
  user              User              @relation(fields: [user_id], references: [id])
  address           Address           @relation(fields: [address_id], references: [id])
  deliveryAddresses DeliveryAddress[]

  @@unique([user_id, address_id])
  @@index([user_id], name: "idx_user_addresses_user_id")
  @@index([address_id], name: "idx_user_addresses_address_id")
  @@map("user_addresses")
}

model EstablishmentAddress {
  id               String        @id @default(ulid())
  establishment_id String        @unique
  address_id       String
  created_at       DateTime      @default(now())
  deleted_at       DateTime?
  address          Address       @relation(fields: [address_id], references: [id])
  establishment    Establishment @relation(fields: [establishment_id], references: [id])

  @@unique([establishment_id, address_id])
  @@index([deleted_at], name: "idx_establishment_addresses_deleted_at")
  @@index([establishment_id], name: "idx_establishment_addresses_establishment_id")
  @@index([address_id], name: "idx_establishment_addresses_address_id")
  @@map("establishment_addresses")
}

model DeliveryAddress {
  id               String        @id @default(ulid())
  establishment_id String
  district_id      String
  user_address_id  String
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  userAddress      UserAddress   @relation(fields: [user_address_id], references: [id])
  establishment    Establishment @relation(fields: [establishment_id], references: [id])
  district         District      @relation(fields: [district_id], references: [id])

  @@unique([user_address_id, establishment_id, district_id])
  @@index([user_address_id], name: "idx_delivery_addresses_user_address_id")
  @@index([establishment_id], name: "idx_delivery_addresses_establishment_id")
  @@index([district_id], name: "idx_delivery_addresses_district_id")
  @@map("delivery_addresses")
}

model OrderDeliveryAddress {
  id            String   @id @default(ulid())
  street        String
  number        String
  city          String
  state         String
  zip_code      String
  shipping_cost Int
  district_name String
  order_id      String   @unique
  address_id    String
  district_id   String
  created_at    DateTime @default(now())
  address       Address  @relation(fields: [address_id], references: [id])
  district      District @relation(fields: [district_id], references: [id])
  order         Order    @relation(fields: [order_id], references: [id])

  @@index([order_id], name: "idx_order_delivery_addresses_order_id")
  @@index([address_id], name: "idx_order_delivery_addresses_address_id")
  @@index([district_id], name: "idx_order_delivery_addresses_district_id")
  @@map("order_delivery_addresses")
}

model Resource {
  id                       String                    @id @default(ulid())
  type                     ResourceType
  path                     String
  file_key                 String
  establishment_id         String
  created_at               DateTime                  @default(now())
  updated_at               DateTime                  @updatedAt
  establishment            Establishment             @relation(fields: [establishment_id], references: [id])
  productResources         ProductResource[]
  establishmentResources   EstablishmentResource[]
  productCategoryResources ProductCategoryResource[]
  bannerResources          BannerResource[]

  @@unique([establishment_id, file_key])
  @@index([establishment_id], name: "idx_resources_establishment_id")
  @@index([file_key], name: "idx_resources_file_key")
  @@map("resources")
}

model FileFormat {
  id               Int            @id @default(autoincrement())
  type             FileFormatType
  resource_rule_id Int
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  resourceType     ResourceRule   @relation(fields: [resource_rule_id], references: [id])

  @@index([resource_rule_id], name: "idx_file_formats_resource_rule_id")
  @@map("file_formats")
}

model ResourceRule {
  id               Int                   @id @default(autoincrement())
  type             ResourceType
  width            Int
  height           Int
  for              ForObjectResourceType
  establishment_id String
  establishment    Establishment         @relation(fields: [establishment_id], references: [id])
  availableFormats FileFormat[]

  @@unique([establishment_id, type, for])
  @@index([type], name: "idx_resource_rules_type")
  @@index([for], name: "idx_resource_rules_for")
  @@map("resource_rules")
}

model BannerResource {
  id          String   @id @default(ulid())
  resource_id String
  banner_id   Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  resource    Resource @relation(fields: [resource_id], references: [id])
  banner      Banner   @relation(fields: [banner_id], references: [id])

  @@unique([banner_id, resource_id])
  @@index([banner_id], name: "idx_banner_resources_banner_id")
  @@index([resource_id], name: "idx_banner_resources_resource_id")
  @@map("banner_resources")
}

model ProductResource {
  id          String   @id @default(ulid())
  resource_id String
  product_id  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  resource    Resource @relation(fields: [resource_id], references: [id])
  product     Product  @relation(fields: [product_id], references: [id])

  @@unique([product_id, resource_id])
  @@index([product_id], name: "idx_product_images_product_id")
  @@index([resource_id], name: "idx_product_images_resource_id")
  @@map("product_resources")
}

model EstablishmentResource {
  id               String        @id @default(ulid())
  resource_id      String
  establishment_id String
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  resource         Resource      @relation(fields: [resource_id], references: [id])
  establishment    Establishment @relation(fields: [establishment_id], references: [id])

  @@unique([establishment_id, resource_id])
  @@index([establishment_id], name: "idx_establishment_resources_establishment_id")
  @@index([resource_id], name: "idx_establishment_resources_resource_id")
  @@map("establishment_resources")
}

model ProductCategoryResource {
  id          String          @id @default(ulid())
  resource_id String
  category_id String
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  resource    Resource        @relation(fields: [resource_id], references: [id])
  category    ProductCategory @relation(fields: [category_id], references: [id])

  @@unique([category_id, resource_id])
  @@index([category_id], name: "idx_product_category_resources_category_id")
  @@index([resource_id], name: "idx_product_category_resources_resource_id")
  @@map("product_category_resources")
}
