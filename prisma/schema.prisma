generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatusType {
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethodType {
  CARD
  PIX
  MONEY
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum BannerLinkType {
  NONE
  PRODUCT
  CATEGORY
}

enum CouponType {
  SHIPPING
  ORDER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum AddonType {
  QUANTITY
  MULTIPLE_CHOICE
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TWITTER
  WHATSAPP
  TIKTOK
}

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum RoleType {
  CUSTOMER
  ESTABLISHMENT_OWNER
  ADMIN
}

enum PermissionType {
  // Customer
  VIEW_CATALOG
  ADD_TO_CART
  MANAGE_ADDRESSES
  VIEW_OWN_ORDERS
  CANCEL_OWN_ORDER

  // Establishment Owner
  MANAGE_PRODUCTS
  MANAGE_CATEGORIES
  MANAGE_PRODUCT_OPTIONS
  MANAGE_DISTRICTS
  MANAGE_ORDERS
  MANAGE_OWN_ESTABLISHMENT
  MANAGE_BANNERS
  MANAGE_COUPONS
  VIEW_CUSTOMERS

  // Admin
  MANAGE_ESTABLISHMENTS
  MANAGE_USERS
}

enum TagType {
  FOOD
  DRINK
  COMBO
  DESSERT
  SNACK
  SIDE
  ALCOHOLIC_DRINK
  NON_ALCOHOLIC_DRINK
  HOT_DRINK
  COLD_DRINK
  COFFEE
  TEA
  JUICE
  SODA
  MILK_SHAKE
  SMOOTHIE
  ICE_CREAM
  BREAKFAST
  LUNCH
  DINNER
  FRUIT
  VEGETABLE
  MEAT
  FISH
  APPETIZER
  PASTRY
  SALAD
  SOUP
  PIZZA
  BURGER
  SANDWICH
  PASTA
  GRILL
  SUSHI
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
  CAKE
  COOKIE
  PIE
}

model Role {
  id          Int              @id @default(autoincrement())
  name        RoleType         @unique
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  PermissionType   @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int
  role          Role       @relation(fields: [role_id], references: [id])
  permission    Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model User {
  id            String         @id @default(ulid())
  name          String
  email         String         @unique
  password      String
  role_id       Int
  created_at    DateTime       @default(now())
  deleted_at    DateTime?
  role          Role           @relation(fields: [role_id], references: [id])
  addresses     Address[]
  orders        Order[]
  favorites     Favorite[]
  userCoupons   UserCoupon[]
  establishment Establishment?

  @@map("users")
}

model Address {
  id              Int       @id @default(autoincrement())
  user_id         String
  district_id     Int
  reference_point String?
  street          String
  number          String
  neighborhood    String
  city            String
  state           String
  zip_code        String
  phone           String
  complement      String?
  deleted_at      DateTime?
  user            User      @relation(fields: [user_id], references: [id])
  district        District  @relation(fields: [district_id], references: [id])
  orders          Order[]

  @@map("addresses")
}

model Menu {
  id               Int           @id @default(autoincrement())
  label            String
  slug             String
  order            Int
  submenus         SubMenu[]
  for_role         RoleType
  establishment_id String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  establishment    Establishment @relation(fields: [establishment_id], references: [id])

  @@unique([establishment_id, slug, for_role])
  @@map("menus")
}

model SubMenu {
  id      Int    @id @default(autoincrement())
  label   String
  slug    String
  order   Int
  menu_id Int
  menu    Menu   @relation(fields: [menu_id], references: [id])

  @@unique([menu_id, slug])
  @@map("submenus")
}

model Establishment {
  id                  String            @id @default(ulid())
  name                String
  slug                String            @unique
  logo_image_key      String
  address             String
  phone               String
  description         String
  email               String            @unique
  cnpj                String?           @unique
  only_delivery       Boolean
  accepts_credit_card Boolean
  is_manually_closed  Boolean           @default(false)
  next_billing_date   DateTime
  created_at          DateTime          @default(now())
  deleted_at          DateTime?
  user_id             String?           @unique
  user                User?             @relation(fields: [user_id], references: [id])
  openingHours        OpeningHour[]
  socialLinks         SocialLink[]
  products            Product[]
  categories          ProductCategory[]
  banners             Banner[]
  districts           District[]
  coupons             Coupon[]
  addonCategories     AddonCategory[]
  orders              Order[]
  menus               Menu[]
  closures            Closure[]
  tags                Tag[]

  @@map("establishments")
}

model OpeningHour {
  id               Int           @id @default(autoincrement())
  establishment_id String
  day_of_week      WeekDay
  opens_at         String
  closes_at        String
  is_closed        Boolean
  establishment    Establishment @relation(fields: [establishment_id], references: [id])

  @@map("opening_hours")
}

model Closure {
  id               Int           @id @default(autoincrement())
  establishment_id String
  starts_at        DateTime
  ends_at          DateTime?
  reason           String?
  establishment    Establishment @relation(fields: [establishment_id], references: [id])

  @@map("closures")
}

model SocialLink {
  id               Int            @id @default(autoincrement())
  establishment_id String
  platform         SocialPlatform
  url              String

  establishment Establishment @relation(fields: [establishment_id], references: [id])

  @@unique([platform, establishment_id])
  @@map("social_links")
}

model ProductCategory {
  id               String    @id @default(ulid())
  establishment_id String
  name             String
  slug             String
  order            Int?
  deleted_at       DateTime?

  establishment Establishment @relation(fields: [establishment_id], references: [id])
  products      Product[]
  banners       Banner[]

  @@unique([slug, establishment_id])
  @@map("product_categories")
}

model Product {
  id                  String          @id @default(ulid())
  establishment_id    String
  category_id         String
  name                String
  description         String
  price               Int
  image_key           String
  slug                String
  discount_percentage Float?
  stock               Int?
  valid_until         DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  deleted_at          DateTime?
  establishment       Establishment   @relation(fields: [establishment_id], references: [id])
  category            ProductCategory @relation(fields: [category_id], references: [id])
  favorites           Favorite[]
  orderItems          OrderItem[]
  banners             Banner[]
  tags                ProductTag[]

  @@unique([slug, establishment_id])
  @@map("products")
}

model Tag {
  id               Int              @id @default(autoincrement())
  establishment_id String
  name             TagType
  deleted_at       DateTime?
  establishment    Establishment    @relation(fields: [establishment_id], references: [id])
  productTags      ProductTag[]
  fromTags         TagCombination[] @relation("FromTag")
  toTags           TagCombination[] @relation("ToTag")

  @@unique([name, establishment_id])
}

model TagCombination {
  id          Int @id @default(autoincrement())
  from_tag_id Int
  to_tag_id   Int
  from_tag    Tag @relation("FromTag", fields: [from_tag_id], references: [id])
  to_tag      Tag @relation("ToTag", fields: [to_tag_id], references: [id])

  @@unique([from_tag_id, to_tag_id])
}

model ProductTag {
  product_id String
  tag_id     Int
  product    Product @relation(fields: [product_id], references: [id])
  tag        Tag     @relation(fields: [tag_id], references: [id])

  @@id([product_id, tag_id])
}

model AddonCategory {
  id               Int           @id @default(autoincrement())
  establishment_id String
  name             String
  status           Boolean       @default(true)
  type             AddonType
  max_quantity     Int?
  deleted_at       DateTime?
  establishment    Establishment @relation(fields: [establishment_id], references: [id])
  addons           Addon[]

  @@unique([name, establishment_id])
  @@map("addon_categories")
}

model Addon {
  id              Int              @id @default(autoincrement())
  category_id     Int
  name            String
  price           Int              @default(0)
  deleted_at      DateTime?
  category        AddonCategory    @relation(fields: [category_id], references: [id])
  orderItemAddons OrderItemAddon[]

  @@unique([name, category_id])
  @@map("addons")
}

model District {
  id               Int           @id @default(autoincrement())
  establishment_id String
  name             String
  shipping_cost    Int
  establishment    Establishment @relation(fields: [establishment_id], references: [id])
  addresses        Address[]
  deleted_at       DateTime?

  @@unique([name, establishment_id])
  @@map("districts")
}

model Coupon {
  id               Int           @id @default(autoincrement())
  establishment_id String
  code             String        @unique
  type             CouponType
  discount_type    DiscountType
  value            Float
  starts_at        DateTime?
  ends_at          DateTime?
  deleted_at       DateTime?
  max_uses         Int?
  uses_per_user    Int?
  establishment    Establishment @relation(fields: [establishment_id], references: [id])
  orders           Order[]
  userCoupons      UserCoupon[]

  @@map("coupons")
}

model UserCoupon {
  id        Int    @id @default(autoincrement())
  user_id   String
  coupon_id Int
  user      User   @relation(fields: [user_id], references: [id])
  coupon    Coupon @relation(fields: [coupon_id], references: [id])

  @@map("user_coupons")
}

model Favorite {
  id         Int     @id @default(autoincrement())
  user_id    String
  product_id String
  user       User    @relation(fields: [user_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])

  @@map("favorites")
}

model Banner {
  id               Int              @id @default(autoincrement())
  name             String
  image_key        String
  establishment_id String
  link_type        BannerLinkType
  product_id       String?
  category_id      String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?
  product          Product?         @relation(fields: [product_id], references: [id])
  category         ProductCategory? @relation(fields: [category_id], references: [id])
  establishment    Establishment    @relation(fields: [establishment_id], references: [id])

  @@map("banners")
}

model Order {
  id               Int               @id @default(autoincrement())
  user_id          String
  establishment_id String
  addressId        Int?
  couponId         Int?
  comment          String?
  change_amount    Int?
  payment_method   PaymentMethodType
  delivery_type    DeliveryType
  shipping_fee     Int
  subtotal         Int
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  deleted_at       DateTime?
  user             User              @relation(fields: [user_id], references: [id])
  establishment    Establishment     @relation(fields: [establishment_id], references: [id])
  address          Address?          @relation(fields: [addressId], references: [id])
  coupon           Coupon?           @relation(fields: [couponId], references: [id])
  items            OrderItem[]
  statuses         OrderStatus[]

  @@map("orders")
}

model OrderItem {
  id             Int              @id @default(autoincrement())
  orderId        Int
  product_id     String
  product_name   String
  product_price  Int
  customer_name  String
  customer_phone String
  quantity       Int
  order          Order            @relation(fields: [orderId], references: [id])
  product        Product          @relation(fields: [product_id], references: [id])
  addons         OrderItemAddon[]

  @@map("order_items")
}

model OrderItemAddon {
  id            Int       @id @default(autoincrement())
  order_item_id Int
  addonPrice    Int       @default(0)
  addonName     String
  addon_id      Int
  quantity      Int
  orderItem     OrderItem @relation(fields: [order_item_id], references: [id])
  addon         Addon     @relation(fields: [addon_id], references: [id])

  @@map("order_item_addons")
}

model OrderStatus {
  id         Int             @id @default(autoincrement())
  order_id   Int
  label      String
  value      OrderStatusType @unique
  created_at DateTime        @default(now())
  order      Order           @relation(fields: [order_id], references: [id])

  @@map("order_statuses")
}
