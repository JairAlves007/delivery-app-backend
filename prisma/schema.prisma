generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatusType {
  Preparing
  Shipped
  Delivered
  Cancelled
}

enum PaymentMethodType {
  Card
  PIX
  Money
}

enum DeliveryType {
  Delivery
  Pickup
}

enum BannerLinkType {
  NONE
  PRODUCT
  CATEGORY
}

enum CouponType {
  Shipping
  Order
}

enum DiscountType {
  Percentage
  Fixed
}

enum AddonType {
  Quantity
  Selection
}

enum SocialPlatform {
  Facebook
  Instagram
  Twitter
  WhatsApp
  TikTok
}

enum WeekDay {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum RoleType {
  CLIENT
  ESTABLISHMENT_OWNER
  ADMIN
}

enum PermissionType {
  // Client
  VIEW_CATALOG
  ADD_TO_CART
  MANAGE_ADDRESSES
  VIEW_OWN_ORDERS
  CANCEL_OWN_ORDER

  // Establishment Owner
  MANAGE_PRODUCTS
  MANAGE_CATEGORIES
  MANAGE_PRODUCT_OPTIONS
  MANAGE_DISTRICTS
  MANAGE_ORDERS
  MANAGE_OWN_STORE
  MANAGE_BANNERS
  MANAGE_COUPONS
  VIEW_CUSTOMERS

  // Admin
  MANAGE_STORES
  MANAGE_USERS
}

model Role {
  id          Int              @id @default(autoincrement())
  name        RoleType
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  PermissionType   @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int
  role          Role       @relation(fields: [role_id], references: [id])
  permission    Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model User {
  id         String       @id @default(uuid())
  name       String
  email      String       @unique
  password   String
  phone      String
  role_id    Int
  created_at DateTime     @default(now())
  deleted_at DateTime?
  role       Role         @relation(fields: [role_id], references: [id])
  addresses  Address[]
  orders     Order[]
  favorites  Favorite[]
  userCoupon UserCoupon[]

  @@map("users")
}

model Address {
  id              Int       @id @default(autoincrement())
  user_id         String
  district_id     Int
  reference_point String?
  street          String
  number          String
  neighborhood    String
  city            String
  state           String
  zip_code        String
  complement      String?
  deleted_at      DateTime?
  user            User      @relation(fields: [user_id], references: [id])
  district        District  @relation(fields: [district_id], references: [id])
  order           Order[]

  @@map("addresses")
}

model Establishment {
  id                  String            @id @default(uuid())
  name                String
  slug                String            @unique
  logo_url            String
  address             String
  phone               String
  description         String
  email               String
  cnpj                String?
  only_delivery       Boolean
  accepts_credit_card Boolean
  next_billing_date   DateTime?
  deleted_at          DateTime?
  openingHours        OpeningHour[]
  socialLinks         SocialLink[]
  products            Product[]
  categories          ProductCategory[]
  banners             Banner[]
  districts           District[]
  coupons             Coupon[]
  addonCategory       AddonCategory[]
  order               Order[]

  @@map("establishments")
}

model OpeningHour {
  id               Int           @id @default(autoincrement())
  establishment_id String
  day_of_week      WeekDay
  opens_at         String
  closes_at        String
  is_closed        Boolean
  establishment    Establishment @relation(fields: [establishment_id], references: [id])

  @@map("opening_hours")
}

model SocialLink {
  id               Int            @id @default(autoincrement())
  establishment_id String
  platform         SocialPlatform
  url              String

  establishment Establishment @relation(fields: [establishment_id], references: [id])

  @@map("social_links")
}

model ProductCategory {
  id               String    @id @default(uuid())
  establishment_id String
  name             String
  slug             String    @unique
  order            Int?
  deleted_at       DateTime?

  establishment Establishment @relation(fields: [establishment_id], references: [id])
  products      Product[]
  banner        Banner[]

  @@map("product_categories")
}

model Product {
  id                  String          @id @default(uuid())
  establishment_id    String
  category_id         String
  name                String
  description         String
  price               Int
  image_url           String
  slug                String          @unique
  discount_percentage Float?
  stock               Int?
  valid_until         DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  deleted_at          DateTime?
  establishment       Establishment   @relation(fields: [establishment_id], references: [id])
  category            ProductCategory @relation(fields: [category_id], references: [id])
  favorites           Favorite[]
  orderItems          OrderItem[]
  banner              Banner[]

  @@map("products")
}

model AddonCategory {
  id               Int           @id @default(autoincrement())
  establishment_id String
  name             String
  status           Boolean       @default(true)
  type             AddonType
  max_quantity     Int?
  deleted_at       DateTime?
  establishment    Establishment @relation(fields: [establishment_id], references: [id])
  addons           Addon[]

  @@map("addon_categories")
}

model Addon {
  id             Int              @id @default(autoincrement())
  category_id    Int
  name           String
  price          Int              @default(0)
  category       AddonCategory    @relation(fields: [category_id], references: [id])
  orderItemAddon OrderItemAddon[]

  @@map("addons")
}

model District {
  id               Int           @id @default(autoincrement())
  establishment_id String
  name             String
  shipping_cost    Int
  establishment    Establishment @relation(fields: [establishment_id], references: [id])
  addresses        Address[]

  @@map("districts")
}

model Coupon {
  id               Int           @id @default(autoincrement())
  establishment_id String
  code             String        @unique
  type             CouponType
  discount_type    DiscountType
  value            Int
  starts_at        DateTime?
  ends_at          DateTime?
  max_uses         Int?
  uses_per_user    Int?
  establishment    Establishment @relation(fields: [establishment_id], references: [id])
  orders           Order[]
  userCoupon       UserCoupon[]

  @@map("coupons")
}

model UserCoupon {
  id        Int    @id @default(autoincrement())
  user_id   String
  coupon_id Int
  user      User   @relation(fields: [user_id], references: [id])
  coupon    Coupon @relation(fields: [coupon_id], references: [id])

  @@map("user_coupons")
}

model Favorite {
  id         Int     @id @default(autoincrement())
  user_id    String
  product_id String
  user       User    @relation(fields: [user_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])

  @@map("favorites")
}

model Banner {
  id               Int              @id @default(autoincrement())
  name             String
  image_url        String
  establishment_id String
  linkType         BannerLinkType
  product_id       String?
  category_id      String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?
  product          Product?         @relation(fields: [product_id], references: [id])
  category         ProductCategory? @relation(fields: [category_id], references: [id])
  establishment    Establishment    @relation(fields: [establishment_id], references: [id])

  @@map("banners")
}

model Order {
  id               Int               @id @default(autoincrement())
  user_id          String
  establishment_id String
  addressId        Int?
  couponId         Int?
  comment          String?
  change_amount    Int?
  payment_method   PaymentMethodType
  delivery_type    DeliveryType
  shipping_fee     Int
  subtotal         Int
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  deleted_at       DateTime?
  user             User              @relation(fields: [user_id], references: [id])
  establishment    Establishment     @relation(fields: [establishment_id], references: [id])
  address          Address?          @relation(fields: [addressId], references: [id])
  coupon           Coupon?           @relation(fields: [couponId], references: [id])
  items            OrderItem[]
  statuses         OrderStatus[]

  @@map("orders")
}

model OrderItem {
  id             Int              @id @default(autoincrement())
  orderId        Int
  product_id     String
  product_name   String
  product_price  Int
  customer_name  String
  customer_phone String
  quantity       Int
  order          Order            @relation(fields: [orderId], references: [id])
  product        Product          @relation(fields: [product_id], references: [id])
  addons         OrderItemAddon[]

  @@map("order_items")
}

model OrderItemAddon {
  id            Int       @id @default(autoincrement())
  order_item_id Int
  addonPrice    Int       @default(0)
  addonName     String
  addon_id      Int
  quantity      Int
  orderItem     OrderItem @relation(fields: [order_item_id], references: [id])
  addon         Addon     @relation(fields: [addon_id], references: [id])

  @@map("order_item_addons")
}

model OrderStatus {
  id         Int             @id @default(autoincrement())
  order_id   Int
  label      String
  value      OrderStatusType @unique
  created_at DateTime        @default(now())
  order      Order           @relation(fields: [order_id], references: [id])

  @@map("order_statuses")
}
