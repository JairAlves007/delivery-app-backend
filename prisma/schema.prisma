generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatusType {
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethodType {
  CARD
  PIX
  MONEY
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum BannerLinkType {
  NONE
  PRODUCT
  CATEGORY
}

enum CouponType {
  SHIPPING
  ORDER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum AddonType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  QUANTITY
  FRACTIONAL
}

enum AddonPricingStrategy {
  SUM
  MAX
  AVERAGE
  NONE
}

enum ProductPricingMode {
  UNIT
  PER_WEIGHT
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TWITTER
  WHATSAPP
  TIKTOK
}

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum MenuAudienceType {
  CUSTOMER
  ESTABLISHMENT_OWNER
  ADMIN
}

enum RoleType {
  ESTABLISHMENT_OWNER
  ADMIN
}

enum PermissionType {
  // Establishment Owner
  MANAGE_PRODUCTS
  MANAGE_CATEGORIES
  MANAGE_PRODUCT_OPTIONS
  MANAGE_DISTRICTS
  MANAGE_ORDERS
  MANAGE_OWN_ESTABLISHMENT
  MANAGE_BANNERS
  MANAGE_COUPONS

  // Admin
  MANAGE_ESTABLISHMENTS
  MANAGE_ESTABLISHMENT_OWNERS
  VIEW_DASHBOARD
}

enum TagType {
  FOOD
  DRINK
  COMBO
  DESSERT
  SNACK
  SIDE
  ALCOHOLIC_DRINK
  NON_ALCOHOLIC_DRINK
  HOT_DRINK
  COLD_DRINK
  COFFEE
  TEA
  JUICE
  SODA
  MILK_SHAKE
  SMOOTHIE
  ICE_CREAM
  BREAKFAST
  LUNCH
  DINNER
  FRUIT
  VEGETABLE
  MEAT
  FISH
  APPETIZER
  PASTRY
  SALAD
  SOUP
  PIZZA
  BURGER
  SANDWICH
  PASTA
  GRILL
  SUSHI
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
  CAKE
  COOKIE
  PIE
}

enum ResourceType {
  BANNER
  LOGO
  THUMBNAIL
}

enum ForObjectResourceType {
  ESTABLISHMENT
  PRODUCT
  CATEGORY
  BANNER
}

enum FileFormatType {
  PNG
  JPG
  JPEG
}

enum ViewType {
  VIEW_DASHBOARD
  VIEW_CATALOG
  VIEW_OWN_BAG
  VIEW_OWN_FAVORITES
  MAKE_OWN_ORDER
  VIEW_OWN_ORDERS
  VIEW_OWN_ADDRESSES
  CREATE_OWN_ADDRESS
  VIEW_ESTABLISHMENTS
  VIEW_CUSTOMERS
  CREATE_ESTABLISHMENT_OWNER
  VIEW_PRODUCTS
  VIEW_ADDONS
  VIEW_ADDON_CATEGORIES
  VIEW_PRODUCT_CATEGORIES
  VIEW_ORDERS
  VIEW_COUPONS
  VIEW_BANNERS
  VIEW_DISTRICTS
  VIEW_TAGS
}

// ─── Core: Auth & RBAC ──────────────────────────────────────────────

model Role {
  id          Int              @id @default(autoincrement())
  name        RoleType         @unique
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  PermissionType   @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([role_id, permission_id])
  @@index([role_id], name: "idx_role_permissions_role_id")
  @@index([permission_id], name: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model User {
  id            String         @id @default(ulid())
  name          String         @db.VarChar(255)
  email         String         @unique @db.VarChar(320)
  password      String         @db.VarChar(255)
  role_id       Int
  created_at    DateTime       @default(now()) @db.Timestamptz
  deleted_at    DateTime?      @db.Timestamptz
  role          Role           @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  establishment Establishment?
  refreshTokens RefreshToken[]

  @@index([role_id], name: "idx_users_role_id")
  @@index([deleted_at], name: "idx_users_deleted_at")
  @@map("users")
}

model RefreshToken {
  id                Int       @id @default(autoincrement())
  user_id           String
  token_hash        String    @db.VarChar(255)
  active_tenant_id  String
  primary_tenant_id String?
  expires_at        DateTime  @db.Timestamptz
  revoked_at        DateTime? @db.Timestamptz
  created_at        DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@index([expires_at, revoked_at], name: "idx_refresh_tokens_active")
  @@map("refresh_tokens")
}

// ─── Establishment & Config ─────────────────────────────────────────

model Establishment {
  id                     String                  @id @default(ulid())
  name                   String                  @db.VarChar(255)
  slug                   String                  @unique @db.VarChar(255)
  description            String                  @db.VarChar(1000)
  email                  String                  @unique @db.VarChar(320)
  cnpj                   String?                 @unique @db.VarChar(18)
  only_delivery          Boolean
  accepts_credit_card    Boolean
  is_manually_closed     Boolean                 @default(false)
  next_billing_date      DateTime                @db.Timestamptz
  owner_id               String?                 @unique
  created_at             DateTime                @default(now()) @db.Timestamptz
  deleted_at             DateTime?               @db.Timestamptz
  owner                  User?                   @relation(fields: [owner_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  openingHours           OpeningHour[]
  socialLinks            SocialLink[]
  products               Product[]
  categories             ProductCategory[]
  banners                Banner[]
  districts              District[]
  coupons                Coupon[]
  addonCategories        AddonCategory[]
  orders                 Order[]
  closures               Closure[]
  tags                   Tag[]
  address                EstablishmentAddress?
  deliveryAddresses      DeliveryAddress[]
  establishmentResources Resource[]
  resources              EstablishmentResource[]

  @@map("establishments")
}

model Menu {
  id           Int              @id @default(autoincrement())
  label        String           @db.VarChar(255)
  slug         String           @db.VarChar(255)
  order        Int
  view_type    ViewType?
  submenus     SubMenu[]
  for_audience MenuAudienceType
  created_at   DateTime         @default(now()) @db.Timestamptz
  updated_at   DateTime         @updatedAt @db.Timestamptz

  @@unique([slug, for_audience])
  @@map("menus")
}

model SubMenu {
  id        Int      @id @default(autoincrement())
  label     String   @db.VarChar(255)
  slug      String   @db.VarChar(255)
  view_type ViewType
  order     Int
  menu_id   Int
  menu      Menu     @relation(fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([menu_id, slug])
  @@index([menu_id], name: "idx_submenus_menu_id")
  @@map("submenus")
}

model OpeningHour {
  id               Int           @id @default(autoincrement())
  establishment_id String
  day_of_week      WeekDay
  opens_at         String        @db.VarChar(5)
  closes_at        String        @db.VarChar(5)
  is_closed        Boolean
  establishment    Establishment @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([establishment_id], name: "idx_opening_hours_establishment_id")
  @@map("opening_hours")
}

model Closure {
  id               Int           @id @default(autoincrement())
  establishment_id String
  starts_at        DateTime      @db.Timestamptz
  ends_at          DateTime?     @db.Timestamptz
  reason           String?       @db.VarChar(500)
  establishment    Establishment @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([establishment_id], name: "idx_closures_establishment_id")
  @@map("closures")
}

model SocialLink {
  id               Int            @id @default(autoincrement())
  establishment_id String
  platform         SocialPlatform
  url              String         @db.VarChar(2048)
  establishment    Establishment  @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([platform, establishment_id])
  @@index([establishment_id], name: "idx_social_links_establishment_id")
  @@map("social_links")
}

// ─── Catalog: Products, Categories, Tags ────────────────────────────

model ProductCategory {
  id               String                    @id @default(ulid())
  establishment_id String
  name             String                    @db.VarChar(255)
  slug             String                    @db.VarChar(255)
  order            Int?
  deleted_at       DateTime?                 @db.Timestamptz
  establishment    Establishment             @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  products         Product[]
  banners          Banner[]
  resources        ProductCategoryResource[]

  @@unique([slug, establishment_id])
  @@index([establishment_id], name: "idx_product_categories_establishment_id")
  @@map("product_categories")
}

model Product {
  id                  String                 @id @default(ulid())
  establishment_id    String
  category_id         String
  name                String                 @db.VarChar(255)
  description         String                 @db.VarChar(2000)
  price               Int
  pricing_mode        ProductPricingMode     @default(UNIT)
  price_per_100g      Int?
  slug                String                 @db.VarChar(255)
  discount_percentage Float?
  stock               Int?
  valid_until         DateTime?              @db.Timestamptz
  created_at          DateTime               @default(now()) @db.Timestamptz
  updated_at          DateTime               @updatedAt @db.Timestamptz
  deleted_at          DateTime?              @db.Timestamptz
  establishment       Establishment          @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category            ProductCategory        @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItems          OrderItem[]
  banners             Banner[]
  tags                ProductTag[]
  resources           ProductResource[]
  addonCategories     ProductAddonCategory[]

  @@unique([slug, establishment_id])
  @@index([establishment_id], name: "idx_products_establishment_id")
  @@index([category_id], name: "idx_products_category_id")
  @@map("products")
}

model Tag {
  id               Int              @id @default(autoincrement())
  establishment_id String
  label            String           @db.VarChar(255)
  type             TagType
  deleted_at       DateTime?        @db.Timestamptz
  establishment    Establishment    @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productTags      ProductTag[]
  fromTags         TagCombination[] @relation("FromTag")
  toTags           TagCombination[] @relation("ToTag")

  @@unique([type, establishment_id])
  @@index([establishment_id], name: "idx_tags_establishment_id")
  @@map("tags")
}

model TagCombination {
  id          Int @id @default(autoincrement())
  from_tag_id Int
  to_tag_id   Int
  from_tag    Tag @relation("FromTag", fields: [from_tag_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  to_tag      Tag @relation("ToTag", fields: [to_tag_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([from_tag_id, to_tag_id])
  @@map("tag_combinations")
}

model ProductTag {
  product_id String
  tag_id     Int
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag        Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([product_id, tag_id])
  @@index([tag_id], name: "idx_product_tags_tag_id")
  @@map("product_tags")
}

// ─── Addons ─────────────────────────────────────────────────────────

model AddonCategory {
  id               Int                    @id @default(autoincrement())
  establishment_id String
  name             String                 @db.VarChar(255)
  type             AddonType
  pricing_strategy AddonPricingStrategy   @default(SUM)
  parts_count      Int?
  deleted_at       DateTime?              @db.Timestamptz
  establishment    Establishment          @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  addons           Addon[]
  products         ProductAddonCategory[]

  @@unique([name, establishment_id])
  @@index([establishment_id], name: "idx_addon_categories_establishment_id")
  @@map("addon_categories")
}

model ProductAddonCategory {
  id                Int     @id @default(autoincrement())
  product_id        String
  addon_category_id Int
  display_order     Int     @default(0)
  is_required       Boolean @default(false)
  min_selection     Int?
  max_selection     Int?

  product       Product       @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  addonCategory AddonCategory @relation(fields: [addon_category_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([product_id, addon_category_id])
  @@index([product_id], name: "idx_product_addon_categories_product_id")
  @@index([addon_category_id], name: "idx_product_addon_categories_addon_category_id")
  @@map("product_addon_categories")
}

model Addon {
  id              Int              @id @default(autoincrement())
  category_id     Int
  name            String           @db.VarChar(255)
  price           Int              @default(0)
  deleted_at      DateTime?        @db.Timestamptz
  category        AddonCategory    @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderItemAddons OrderItemAddon[]

  @@unique([name, category_id])
  @@index([category_id], name: "idx_addons_category_id")
  @@map("addons")
}

// ─── Delivery: Districts & Addresses ────────────────────────────────

model District {
  id                     String                 @id @default(ulid())
  establishment_id       String
  name                   String                 @db.VarChar(255)
  shipping_cost          Int
  establishment          Establishment          @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveryLinks          DeliveryAddress[]
  deleted_at             DateTime?              @db.Timestamptz
  orderDeliveryAddresses OrderDeliveryAddress[]

  @@unique([name, establishment_id])
  @@index([establishment_id], name: "idx_districts_establishment_id")
  @@map("districts")
}

model Address {
  id                     String                 @id @default(ulid())
  street                 String                 @db.VarChar(255)
  number                 String?                @default("N/A") @db.VarChar(20)
  neighborhood           String                 @db.VarChar(255)
  city                   String                 @db.VarChar(255)
  state                  String                 @db.VarChar(255)
  postal_code            String                 @db.VarChar(10)
  complement             String?                @db.VarChar(500)
  reference_point        String?                @db.VarChar(500)
  phone                  String                 @db.VarChar(20)
  latitude               Float?
  longitude              Float?
  created_at             DateTime               @default(now()) @db.Timestamptz
  updated_at             DateTime               @updatedAt @db.Timestamptz
  deleted_at             DateTime?              @db.Timestamptz
  establishmentAddresses EstablishmentAddress[]

  @@index([deleted_at], name: "idx_addresses_deleted_at")
  @@map("addresses")
}

model EstablishmentAddress {
  id               String        @id @default(ulid())
  establishment_id String        @unique
  address_id       String
  created_at       DateTime      @default(now()) @db.Timestamptz
  deleted_at       DateTime?     @db.Timestamptz
  address          Address       @relation(fields: [address_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  establishment    Establishment @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([establishment_id, address_id])
  @@index([deleted_at], name: "idx_establishment_addresses_deleted_at")
  @@index([establishment_id], name: "idx_establishment_addresses_establishment_id")
  @@index([address_id], name: "idx_establishment_addresses_address_id")
  @@map("establishment_addresses")
}

model DeliveryAddress {
  id               String        @id @default(ulid())
  establishment_id String
  district_id      String
  user_address_id  String
  created_at       DateTime      @default(now()) @db.Timestamptz
  updated_at       DateTime      @updatedAt @db.Timestamptz
  establishment    Establishment @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  district         District      @relation(fields: [district_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([establishment_id], name: "idx_delivery_addresses_establishment_id")
  @@index([district_id], name: "idx_delivery_addresses_district_id")
  @@map("delivery_addresses")
}

// ─── Banners ────────────────────────────────────────────────────────

model Banner {
  id               String           @id @default(ulid())
  name             String           @db.VarChar(255)
  establishment_id String
  link_type        BannerLinkType
  product_id       String?
  category_id      String?
  created_at       DateTime         @default(now()) @db.Timestamptz
  updated_at       DateTime         @updatedAt @db.Timestamptz
  deleted_at       DateTime?        @db.Timestamptz
  product          Product?         @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  category         ProductCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  establishment    Establishment    @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resources        BannerResource[]

  @@index([establishment_id], name: "idx_banners_establishment_id")
  @@map("banners")
}

// ─── Coupons ────────────────────────────────────────────────────────

model Coupon {
  id               Int           @id @default(autoincrement())
  establishment_id String
  code             String        @unique @db.VarChar(50)
  type             CouponType
  discount_type    DiscountType
  value            Float
  starts_at        DateTime?     @db.Timestamptz
  ends_at          DateTime?     @db.Timestamptz
  deleted_at       DateTime?     @db.Timestamptz
  max_uses         Int?
  uses_per_user    Int?
  establishment    Establishment @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orders           Order[]
  userCoupons      UserCoupon[]

  @@index([establishment_id], name: "idx_coupons_establishment_id")
  @@index([deleted_at], name: "idx_coupons_deleted_at")
  @@map("coupons")
}

model UserCoupon {
  id             Int    @id @default(autoincrement())
  customer_phone String @db.VarChar(20)
  coupon_id      Int
  coupon         Coupon @relation(fields: [coupon_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([customer_phone], name: "idx_user_coupons_customer_phone")
  @@index([coupon_id], name: "idx_user_coupons_coupon_id")
  @@map("user_coupons")
}

// ─── Orders ─────────────────────────────────────────────────────────

model Order {
  id                   String                @id @default(ulid())
  comment              String?               @db.VarChar(500)
  change_amount        Int?
  payment_method       PaymentMethodType
  delivery_type        DeliveryType
  shipping_fee         Int
  subtotal             Int
  customer_name        String                @db.VarChar(255)
  customer_phone       String                @db.VarChar(20)
  establishment_id     String
  coupon_id            Int?
  created_at           DateTime              @default(now()) @db.Timestamptz
  updated_at           DateTime              @updatedAt @db.Timestamptz
  deleted_at           DateTime?             @db.Timestamptz
  establishment        Establishment         @relation(fields: [establishment_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items                OrderItem[]
  statuses             OrderStatus[]
  coupon               Coupon?               @relation(fields: [coupon_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  orderCoupon          OrderCoupon?
  orderDeliveryAddress OrderDeliveryAddress?

  @@index([establishment_id], name: "idx_orders_establishment_id")
  @@index([coupon_id], name: "idx_orders_coupon_id")
  @@index([created_at], name: "idx_orders_created_at")
  @@map("orders")
}

model OrderCoupon {
  id             Int          @id @default(autoincrement())
  order_id       String       @unique
  code           String       @db.VarChar(50)
  discount_type  DiscountType
  discount_value Int
  created_at     DateTime     @default(now()) @db.Timestamptz
  order          Order        @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("order_coupons")
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  order_id             String
  product_id           String
  product_name         String   @db.VarChar(255)
  product_price        Int
  quantity             Int
  weight_grams         Int?
  addons_subtotal      Int      @default(0)
  created_at           DateTime @default(now()) @db.Timestamptz

  order   Order            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product          @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  addons  OrderItemAddon[]

  @@index([order_id], name: "idx_order_items_order_id")
  @@index([product_id], name: "idx_order_items_product_id")
  @@map("order_items")
}

model OrderItemAddon {
  id            Int       @id @default(autoincrement())
  order_item_id Int
  addon_price   Int       @default(0)
  addon_name    String    @db.VarChar(255)
  addon_id      Int
  quantity      Int
  orderItem     OrderItem @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  addon         Addon     @relation(fields: [addon_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([order_item_id], name: "idx_order_item_addons_order_item_id")
  @@index([addon_id], name: "idx_order_item_addons_addon_id")
  @@map("order_item_addons")
}

model OrderStatus {
  id         Int             @id @default(autoincrement())
  order_id   String
  label      String          @db.VarChar(100)
  value      OrderStatusType
  created_at DateTime        @default(now()) @db.Timestamptz
  order      Order           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([order_id, value])
  @@map("order_statuses")
}

model OrderDeliveryAddress {
  id              String   @id @default(ulid())
  street          String   @db.VarChar(255)
  number          String?  @default("N/A") @db.VarChar(20)
  neighborhood    String?  @db.VarChar(255)
  city            String   @db.VarChar(255)
  state           String   @db.VarChar(255)
  postal_code     String   @db.VarChar(10)
  complement      String?  @db.VarChar(500)
  reference_point String?  @db.VarChar(500)
  shipping_cost   Int
  district_name   String   @db.VarChar(255)
  order_id        String   @unique
  district_id     String
  created_at      DateTime @default(now()) @db.Timestamptz
  district        District @relation(fields: [district_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order           Order    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([order_id], name: "idx_order_delivery_addresses_order_id")
  @@index([district_id], name: "idx_order_delivery_addresses_district_id")
  @@map("order_delivery_addresses")
}

// ─── Resources & Uploads ────────────────────────────────────────────

model Resource {
  id                       String                    @id @default(ulid())
  type                     ResourceType
  path                     String                    @db.VarChar(500)
  file_key                 String                    @db.VarChar(500)
  establishment_id         String
  created_at               DateTime                  @default(now()) @db.Timestamptz
  updated_at               DateTime                  @updatedAt @db.Timestamptz
  establishment            Establishment             @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productResources         ProductResource[]
  establishmentResources   EstablishmentResource[]
  productCategoryResources ProductCategoryResource[]
  bannerResources          BannerResource[]

  @@unique([establishment_id, file_key])
  @@index([establishment_id], name: "idx_resources_establishment_id")
  @@index([file_key], name: "idx_resources_file_key")
  @@map("resources")
}

model FileFormat {
  id               Int            @id @default(autoincrement())
  type             FileFormatType
  resource_rule_id Int
  created_at       DateTime       @default(now()) @db.Timestamptz
  updated_at       DateTime       @updatedAt @db.Timestamptz
  resourceType     ResourceRule   @relation(fields: [resource_rule_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([resource_rule_id], name: "idx_file_formats_resource_rule_id")
  @@map("file_formats")
}

model ResourceRule {
  id               Int                   @id @default(autoincrement())
  type             ResourceType
  width            Int
  height           Int
  for              ForObjectResourceType
  availableFormats FileFormat[]

  @@unique([type, for])
  @@index([type], name: "idx_resource_rules_type")
  @@index([for], name: "idx_resource_rules_for")
  @@map("resource_rules")
}

model BannerResource {
  id          String   @id @default(ulid())
  resource_id String
  banner_id   String
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz
  resource    Resource @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  banner      Banner   @relation(fields: [banner_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([banner_id, resource_id])
  @@index([banner_id], name: "idx_banner_resources_banner_id")
  @@index([resource_id], name: "idx_banner_resources_resource_id")
  @@map("banner_resources")
}

model ProductResource {
  id          String   @id @default(ulid())
  resource_id String
  product_id  String
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz
  resource    Resource @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([product_id, resource_id])
  @@index([product_id], name: "idx_product_images_product_id")
  @@index([resource_id], name: "idx_product_images_resource_id")
  @@map("product_resources")
}

model EstablishmentResource {
  id               String        @id @default(ulid())
  resource_id      String
  establishment_id String
  created_at       DateTime      @default(now()) @db.Timestamptz
  updated_at       DateTime      @updatedAt @db.Timestamptz
  resource         Resource      @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  establishment    Establishment @relation(fields: [establishment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([establishment_id, resource_id])
  @@index([establishment_id], name: "idx_establishment_resources_establishment_id")
  @@index([resource_id], name: "idx_establishment_resources_resource_id")
  @@map("establishment_resources")
}

model ProductCategoryResource {
  id          String          @id @default(ulid())
  resource_id String
  category_id String
  created_at  DateTime        @default(now()) @db.Timestamptz
  updated_at  DateTime        @updatedAt @db.Timestamptz
  resource    Resource        @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category    ProductCategory @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([category_id, resource_id])
  @@index([category_id], name: "idx_product_category_resources_category_id")
  @@index([resource_id], name: "idx_product_category_resources_resource_id")
  @@map("product_category_resources")
}
