generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatusType {
  Preparing
  Shipped
  Delivered
  Cancelled
}

enum PaymentMethodType {
  Card
  PIX
  Money
}

enum DeliveryType {
  Delivery
  Pickup
}

enum BannerLinkType {
  NONE
  PRODUCT
  CATEGORY
}

enum CouponType {
  Shipping
  Order
}

enum DiscountType {
  Percentage
  Fixed
}

enum AddonType {
  Quantity
  Selection
}

enum SocialPlatform {
  Facebook
  Instagram
  Twitter
  WhatsApp
  TikTok
}

enum WeekDay {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum RoleType {
  CLIENT
  ESTABLISHMENT_OWNER
  ADMIN
}

enum PermissionType {
  // Client
  VIEW_CATALOG
  ADD_TO_CART
  MANAGE_ADDRESSES
  VIEW_OWN_ORDERS
  CANCEL_OWN_ORDER

  // Establishment Owner
  MANAGE_PRODUCTS
  MANAGE_CATEGORIES
  MANAGE_PRODUCT_OPTIONS
  MANAGE_DISTRICTS
  MANAGE_ORDERS
  MANAGE_OWN_STORE
  MANAGE_BANNERS
  MANAGE_COUPONS
  VIEW_CUSTOMERS

  // Admin
  MANAGE_STORES
  MANAGE_USERS
}

model Role {
  id          Int              @id @default(autoincrement())
  name        RoleType
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  PermissionType   @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  phone     String
  roleId    Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  role      Role       @relation(fields: [roleId], references: [id])
  addresses Address[]
  orders    Order[]
  favorites Favorite[]

  @@map("users")
}

model Address {
  id             Int       @id @default(autoincrement())
  userId         String
  districtId     Int
  referencePoint String?
  street         String
  number         String
  neighborhood   String
  city           String
  state          String
  zipCode        String
  complement     String?
  deletedAt      DateTime?

  user     User     @relation(fields: [userId], references: [id])
  district District @relation(fields: [districtId], references: [id])
  order    Order[]

  @@map("addresses")
}

model Establishment {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  logoUrl         String
  address         String
  phone           String
  description     String
  email           String
  cnpj            String?
  onlyDelivery    Boolean
  acceptsCard     Boolean
  socialLinks     SocialLink[]
  openingHours    OpeningHour[]
  nextBillingDate DateTime?
  deletedAt       DateTime?

  products      Product[]
  categories    ProductCategory[]
  banners       Banner[]
  districts     District[]
  coupons       Coupon[]
  addonCategory AddonCategory[]
  order         Order[]

  @@map("establishments")
}

model OpeningHour {
  id              Int     @id @default(autoincrement())
  establishmentId String
  dayOfWeek       WeekDay
  opensAt         String
  closesAt        String
  isClosed        Boolean

  establishment Establishment @relation(fields: [establishmentId], references: [id])

  @@map("opening_hours")
}

model SocialLink {
  id              Int            @id @default(autoincrement())
  establishmentId String
  platform        SocialPlatform
  url             String

  establishment Establishment @relation(fields: [establishmentId], references: [id])

  @@map("social_links")
}

model ProductCategory {
  id              String    @id @default(uuid())
  establishmentId String
  name            String
  slug            String    @unique
  order           Int?
  deletedAt       DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  products      Product[]

  @@map("product_categories")
}

model Product {
  id              String    @id @default(uuid())
  establishmentId String
  categoryId      String
  name            String
  description     String
  price           Int
  imageUrl        String
  slug            String    @unique
  discountPercent Float?
  stock           Int?
  validUntil      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  establishment Establishment   @relation(fields: [establishmentId], references: [id])
  category      ProductCategory @relation(fields: [categoryId], references: [id])
  favorites     Favorite[]
  orderItems    OrderItem[]

  @@map("products")
}

model AddonCategory {
  id              Int       @id @default(autoincrement())
  establishmentId String
  name            String
  status          Boolean   @default(true)
  type            AddonType
  maxQuantity     Int?
  deletedAt       DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  addons        Addon[]

  @@map("addon_categories")
}

model Addon {
  id         Int    @id @default(autoincrement())
  categoryId Int
  name       String
  price      Int    @default(0)

  category       AddonCategory    @relation(fields: [categoryId], references: [id])
  orderItemAddon OrderItemAddon[]

  @@map("addons")
}

model District {
  id              Int    @id @default(autoincrement())
  establishmentId String
  name            String
  shippingCost    Int

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  addresses     Address[]

  @@map("districts")
}

model Coupon {
  id              Int          @id @default(autoincrement())
  establishmentId String
  code            String       @unique
  type            CouponType
  discountType    DiscountType
  value           Int
  startsAt        DateTime?
  endsAt          DateTime?
  maxUses         Int?
  usesPerUser     Int?

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  orders        Order[]

  @@map("coupons")
}

model Favorite {
  id        Int    @id @default(autoincrement())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("favorites")
}

model Banner {
  id              Int            @id @default(autoincrement())
  name            String
  imageUrl        String
  establishmentId String
  linkType        BannerLinkType
  productId       String?
  categoryId      Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id])

  @@map("banners")
}

model Order {
  id              Int               @id @default(autoincrement())
  userId          String
  establishmentId String
  addressId       Int?
  couponId        Int?
  comment         String?
  changeAmount    Int?
  paymentMethod   PaymentMethodType
  deliveryType    DeliveryType
  shippingFee     Int
  subtotal        Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  user          User          @relation(fields: [userId], references: [id])
  establishment Establishment @relation(fields: [establishmentId], references: [id])
  address       Address?      @relation(fields: [addressId], references: [id])
  coupon        Coupon?       @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  statuses      OrderStatus[]

  @@map("orders")
}

model OrderItem {
  id            Int    @id @default(autoincrement())
  orderId       Int
  productId     String
  productName   String
  productPrice  Int
  customerName  String
  customerPhone String
  quantity      Int

  order   Order            @relation(fields: [orderId], references: [id])
  product Product          @relation(fields: [productId], references: [id])
  addons  OrderItemAddon[]

  @@map("order_items")
}

model OrderItemAddon {
  id          Int    @id @default(autoincrement())
  orderItemId Int
  addonPrice  Int    @default(0)
  addonName   String
  addonId     Int
  quantity    Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  addon     Addon     @relation(fields: [addonId], references: [id])

  @@map("order_item_addons")
}

model OrderStatus {
  id        Int             @id @default(autoincrement())
  orderId   Int
  label     String
  value     OrderStatusType @unique
  createdAt DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_statuses")
}
